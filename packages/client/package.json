{
  "name": "@for/client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "SPA Vite + React. Affiche, saisit des intentions, ne decide rien.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@for/contracts": "workspace:*",
    "@for/engine": "workspace:*",
    "@tanstack/react-query": "^5.90.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@for/testkit": "workspace:*",
    "@for/tsconfig": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.0.0",
    "vite": "^7.1.12"
  }
}
