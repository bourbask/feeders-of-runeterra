{
  "name": "@for/scenario",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Construction guidee d un scenario : le moteur pose la question, le modele choisit.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@for/content": "workspace:*",
    "@for/contracts": "workspace:*",
    "@for/engine": "workspace:*"
  },
  "devDependencies": {
    "@for/tsconfig": "workspace:*"
  }
}
