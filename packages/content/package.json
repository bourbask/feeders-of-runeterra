{
  "name": "@for/content",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Donnees de jeu versionnees et registre type.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@for/contracts": "workspace:*"
  },
  "devDependencies": {
    "@for/tsconfig": "workspace:*"
  }
}
