{
  "name": "@for/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Schemas Zod et types deduits, partages par le front, le back et le moteur.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@for/tsconfig": "workspace:*"
  }
}
