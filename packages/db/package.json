{
  "name": "@for/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Schema Drizzle, migrations, SQLite WAL, journal d evenements.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:rebuild": "tsx src/cli/rebuild.ts",
    "db:check": "tsx src/cli/check.ts",
    "db:seed": "tsx src/seed/cli-seed.ts",
    "db:reset": "tsx src/seed/cli-reset.ts"
  },
  "dependencies": {
    "@for/contracts": "workspace:*",
    "@for/engine": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3"
  },
  "devDependencies": {
    "@for/content": "workspace:*",
    "@for/testkit": "workspace:*",
    "@for/tsconfig": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.6"
  }
}
