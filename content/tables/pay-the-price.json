    {
      "id": "un-allie-paie-a-ta-place",
      "min": 1,
      "max": 1,
      "text": "Quelqu'un d'autre paie à ta place, et il le saura toute sa vie.",
      "severity": "serieuse",
      "suggestedEffects": [
        { "op": "gauge", "gauge": "ame", "delta": -1, "target": "self" },
        { "op": "condition_add", "conditionId": "endette" }
