# Variables d'environnement — modèle de référence.
# Copier en `.env` et remplir. Schéma de validation : packages/server/src/env.ts (zEnv).
# Toute variable manquante ou invalide ARRÊTE le processus au démarrage, avec son nom.
# Aucune variable n'est lue ailleurs que dans env.ts.
# Référence : docs/design/01-architecture.md §9.4.

# ── Serveur ─────────────────────────────────────────────
NODE_ENV=development
PORT=8787
PUBLIC_URL=http://localhost:5173

# ── Base ────────────────────────────────────────────────
# Fichier SQLite (mode WAL). Jamais versionné. En production : /app/data/app.db
DATABASE_PATH=./data/app.db

# ── Auth Discord ────────────────────────────────────────
# Portail développeur Discord → ton application → OAuth2.
# Le secret n'est affiché qu'une fois : « Reset Secret » pour en régénérer un.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8787/api/auth/discord/callback
# 32 octets minimum.
SESSION_SECRET=

# ── Le Conteur (un PORT, côté serveur UNIQUEMENT) ───────
# Jamais depuis le navigateur : ce serait exposer la clé et confier la
# narration à un client non fiable.
# Le serveur ne parle pas à un fournisseur mais à une interface unique
# (`NarratorPort` : narrer() + structurer()), avec des adaptateurs derrière.
# Spécification complète : docs/design/02-mj-ia.md §0.1 à §0.6.

# stub | anthropic | openai-compatible | ollama
#   stub              : gabarits de repli du moteur, ZÉRO sortie réseau.
#                       C'est le mode de la CI et du simulateur — et le SEUL
#                       interrupteur de mode dégradé volontaire.
#   anthropic         : SDK officiel. Tout est natif (outils, sortie structurée, cache).
#   openai-compatible : OpenRouter, Groq, Together, passerelles auto-hébergées.
#                       Le plus courant, et la voie « sans budget ».
#   ollama            : modèle local sur la machine de l'hôte de la table.
NARRATOR_PROVIDER=stub

# Point d'entrée HTTP du fournisseur.
# Obligatoire pour openai-compatible (ex. https://openrouter.ai/api/v1)
# et pour ollama (ex. http://localhost:11434).
# Facultatif pour anthropic (défaut du SDK). Ignoré pour stub.
NARRATOR_BASE_URL=

# Obligatoire pour anthropic et openai-compatible.
# PEUT RESTER VIDE pour ollama et stub : c'est la seule exception à la règle
# « toute variable manquante arrête le processus ».
NARRATOR_API_KEY=

# Résolution du nom de modèle, ordre unique :
#   campaigns.settings_json.models.<usage>  >  NARRATOR_MODEL /
#   NARRATOR_MODEL_STRUCTURED  >  défaut de l'adaptateur sélectionné.
# Laisser vide pour prendre le défaut de l'adaptateur. Il n'existe AUCUNE
# table de modèles partagée dans le code : c'est une donnée d'adaptateur.
NARRATOR_MODEL=                 # usage narrer()   — la narration, sur le chemin du joueur
NARRATOR_MODEL_STRUCTURED=      # usage structurer() — forge, chronique, juge

# Variables d'appoint, propres à un adaptateur, toutes facultatives.
# NARRATOR_TOOLS : on | off | probe (défaut probe). Les appels d'outils ne sont
#   pas fiables partout ; `probe` sonde le fournisseur une fois au démarrage.
#   L'adaptateur ollama vaut `off` par défaut.
# NARRATOR_TIMEOUT_MS : défaut 60000. À monter pour un modèle local qui charge à froid.
# NARRATOR_CONTEXT_WINDOW : fenêtre du modèle, en tokens. Gouverne le budget de
#   contexte, qui vise min(14000, fenêtre × 0,6). Défaut prudent selon l'adaptateur.
#NARRATOR_TOOLS=probe
#NARRATOR_TIMEOUT_MS=60000
#NARRATOR_CONTEXT_WINDOW=

# ── Journaux ────────────────────────────────────────────
LOG_LEVEL=info
