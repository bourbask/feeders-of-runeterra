# ── Serveur ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development
PUBLIC_URL=http://localhost:5173

# ── Base ────────────────────────────────────────────────
# Fichier SQLite. Jamais versionné.
DATABASE_URL=file:./data/feeders.db

# ── Auth Discord ────────────────────────────────────────
# Portail développeur Discord → ton application → OAuth2.
# Le secret n'est affiché qu'une fois : « Reset Secret » pour en régénérer un.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
SESSION_SECRET=

# ── Le conteur (modèle de langage) ──────────────────────
# Le serveur parle à un port unique : n'importe quel fournisseur
# compatible OpenAI, ou Anthropic, ou un modèle local.
#   NARRATOR_PROVIDER = anthropic | openai-compatible | ollama
NARRATOR_PROVIDER=openai-compatible
NARRATOR_BASE_URL=https://openrouter.ai/api/v1
NARRATOR_API_KEY=
# Modèle pour la narration : rapide, court, chaud
NARRATOR_MODEL=
# Modèle pour le travail structuré (forge de fiches, compaction de chronique) :
# doit tenir un schéma JSON strict. Peut être le même.
NARRATOR_MODEL_STRUCTURED=
