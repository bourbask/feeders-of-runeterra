# Gabarit du dépôt. Copier en .env et remplir.
# Autorité sur ce fichier : docs/design/01-architecture.md §9.4.
# Les trois mêmes valeurs vivent aussi dans docs/design/02-mj-ia.md §0.6 :
# si l'une des trois change, les deux autres changent dans la même PR.

NODE_ENV=development
PORT=8787
PUBLIC_URL=http://localhost:5173
LOG_LEVEL=info

# ── Base ────────────────────────────────────────────────────────────────
# Fichier SQLite en mode WAL. Jamais versionné.
DATABASE_PATH=./data/app.db

# ── Sessions et authentification Discord ────────────────────────────────
# 32 octets au minimum : openssl rand -base64 32
SESSION_SECRET=
# Portail développeur Discord → ton application → OAuth2.
# Le secret n'est affiché qu'une fois : « Reset Secret » pour en régénérer un.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8787/api/auth/discord/callback

# ── Le conteur ──────────────────────────────────────────────────────────
# Le serveur parle à un port unique ; le fournisseur est un adaptateur.
#   stub | anthropic | openai-compatible | ollama
# `stub` rend les gabarits de repli du moteur sans aucune sortie réseau :
# c'est ce qui permet au simulateur et à `pnpm eval:offline` de tourner sans clé.
# Le défaut recommandé pour une vraie table sortira de la mesure de M0-31.
NARRATOR_PROVIDER=stub
NARRATOR_BASE_URL=            # obligatoire pour openai-compatible et ollama
NARRATOR_API_KEY=             # peut rester vide pour ollama et stub
NARRATOR_MODEL=               # vide => défaut de l'adaptateur
NARRATOR_MODEL_STRUCTURED=    # vide => défaut de l'adaptateur

# Variables d'appoint, facultatives, propres à un adaptateur.
#NARRATOR_TOOLS=probe         # on | off | probe   — défaut probe
#NARRATOR_TIMEOUT_MS=60000    # millisecondes      — défaut 60000, à monter pour ollama
#NARRATOR_CONTEXT_WINDOW=     # tokens             — défaut de l'adaptateur
